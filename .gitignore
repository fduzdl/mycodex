# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Environment & secrets
.env
.env.*
api.txt

# Legacy provider profile files (architecture removed — models now come from
# the machine's codex login). Keep ignored defensively in case old files linger.
config/settings_*.json

# Local/personal config (machine-specific paths, runtime state, generated)
config/shortcuts.json
config/claude_settings.json
config/active_profile
config/global_preferences.json
config/feishu_group_imports.json

# Logs & runtime output
*.log
logs/
/fed_rate_*.html

# Session persistence
.sessions/

# Windows Zone.Identifier
*.Zone.Identifier

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# User personal notes (local only — 2026-10-03: legacy Sep-era docs untracked;
# outdated content misled setups, e.g. the D:\projects\demo example incident)
doc/

# Feishu setup runtime artifacts and credentials
auto_feishu/feishu-app-result.json
auto_feishu/artifacts/
auto_feishu/node_modules/
prev_work/feishu-app-result.json
prev_work/artifacts/

# Runtime preferences & test cache
.preferences/
.pytest_cache/
.ruff_cache/

# Local runtime workspace config & logs
.claude/
.agents/
audit.log

# Subproject secrets & txt files
auto_feishu/*.txt

# WeCom setup runtime artifacts and credentials
auto_wecom/wecom-bot-result.json
auto_wecom/artifacts/
auto_wecom/node_modules/
auto_wecom/dist/
auto_wecom/*.log

# 默认初始工作目录（保留 .gitkeep，忽略客户任意测试产生的临时文件）
workspace/*
!workspace/.gitkeep

